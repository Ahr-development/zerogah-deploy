{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/[lang]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/[lang].segments/$d$lang$segment",
          "source": "^/(?<nxtPlang>[^/]+?)\\.segments/\\$d\\$lang(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPlang": "nxtPlang"
          }
        }
      ]
    },
    {
      "sourcePage": "/[lang]/art/[slug]",
      "page": "/en/art/[slug]",
      "regex": "^/en/art/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/en/art/(?<nxtPslug>[^/]+?)(?:/)?$",
      "skipInternalRouting": true,
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/en/art/[slug].segments/$d$lang/art/$d$slug$segment",
          "source": "^/en/art/(?<nxtPslug>[^/]+?)\\.segments/\\$d\\$lang/art/\\$d\\$slug(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPslug": "nxtPslug"
          }
        }
      ]
    },
    {
      "sourcePage": "/[lang]/art/[slug]",
      "page": "/fa/art/[slug]",
      "regex": "^/fa/art/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/fa/art/(?<nxtPslug>[^/]+?)(?:/)?$",
      "skipInternalRouting": true,
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/fa/art/[slug].segments/$d$lang/art/$d$slug$segment",
          "source": "^/fa/art/(?<nxtPslug>[^/]+?)\\.segments/\\$d\\$lang/art/\\$d\\$slug(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPslug": "nxtPslug"
          }
        }
      ]
    },
    {
      "page": "/[lang]/art/[slug]",
      "regex": "^/([^/]+?)/art/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/art/(?<nxtPslug>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/[lang]/art/[slug].segments/$d$lang/art/$d$slug$segment",
          "source": "^/(?<nxtPlang>[^/]+?)/art/(?<nxtPslug>[^/]+?)\\.segments/\\$d\\$lang/art/\\$d\\$slug(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPlang": "nxtPlang",
            "nxtPslug": "nxtPslug"
          }
        }
      ]
    },
    {
      "page": "/[lang]/signin",
      "regex": "^/([^/]+?)/signin(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/signin(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/[lang]/signin.segments/$d$lang/signin$segment",
          "source": "^/(?<nxtPlang>[^/]+?)/signin\\.segments/\\$d\\$lang/signin(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPlang": "nxtPlang"
          }
        }
      ]
    }
  ],
  "staticRoutes": [
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": true,
    "dynamicRSCPrerender": true
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "ppr": {
    "chain": {
      "headers": {
        "next-resume": "1"
      }
    }
  }
}